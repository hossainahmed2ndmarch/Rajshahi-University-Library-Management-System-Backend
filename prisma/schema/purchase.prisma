// Purchase Model 

model Purchase {
  id Int @id @default(autoincrement())

  // Public tracking reference for Guests & Members
  transactionId String @unique

  // Optional User relation (NULL for Guests)
  userId Int?
  user   User? @relation("UserPurchases", fields: [userId], references: [id], onDelete: SetNull)

  // Customer Contact Info (Required for Guests & Members)
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String @db.Text

  // Book Item Reference
  bookId Int
  book   Book @relation(fields: [bookId], references: [id])

  // Order Pricing Breakdown & Discounts
  quantity        Int            @default(1)
  unitPrice       Float
  discountAmount  Float          @default(0)
  deliveryCharge  Float          @default(0)
  totalAmount     Float

  // Coupon Relation
  couponId        Int?
  coupon          Coupon?        @relation("CouponPurchases", fields: [couponId], references: [id], onDelete: SetNull)
  couponCode      String?

  // Delivery & Logistics
  deliveryMethod  DeliveryMethod @default(COURIER)

  // Status & Tracking Pipeline
  orderStatus     OrderStatus    @default(PENDING)
  paymentStatus   PaymentStatus  @default(PENDING)
  paymentMethod   PaymentMethod  @default(CASH)

  // Manual MFS Verification (bKash / Nagad / Rocket)
  mfsProvider     MFSProvider?
  senderPhone     String?
  customerTrxId   String?
  paymentVerified Boolean        @default(false)
  verifiedAt      DateTime?

  // Courier & Tracking Info
  courierName     String?
  trackingNumber  String?
  deliveryOtpHash String?        // 6-digit OTP hashed for secure delivery handover
  otpExpiresAt    DateTime?
  otpVerified     Boolean        @default(false)

  // Operational Stamps
  shippedAt       DateTime?
  deliveredAt     DateTime?

  approvedById    Int?
  approvedBy      User?          @relation("ApprovedPurchases", fields: [approvedById], references: [id], onDelete: SetNull)

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@map("purchases")
}
