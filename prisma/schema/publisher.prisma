model Publisher {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  logo            String?
  description     String?  @db.Text
  websiteUrl      String?
  defaultDiscount Decimal  @default(0.00) @db.Decimal(5, 2) // Publisher percentage discount (0-100)

  books           Book[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("publishers")
}