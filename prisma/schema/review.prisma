// Book Reviews Model 
model BookReview {
 id      Int     @id @default(autoincrement())
 rating  Int
 comment String? @db.Text

 // User Relation (Optional for buyable/hybrid books reviewed by guests)
 userId Int?
 user   User? @relation(fields: [userId], references: [id], onDelete: Cascade)

 // Guest Reviewer Info (Populated if user is not logged in)
 reviewerName  String?
 reviewerEmail String?
 isAnonymous   Boolean @default(false)

 // Book Relation
 bookId Int
 book   Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 // Key Indexes & Constraints
 @@index([bookId])
 @@index([userId])
 @@map("book_reviews")
}

// Service Reviews Model 
model ServiceReview {
 id      Int     @id @default(autoincrement())
 rating  Int
 comment String? @db.Text

 // Anonymous Feature
 isAnonymous Boolean @default(false)

 userId Int?
 user   User? @relation(fields: [userId], references: [id], onDelete: SetNull)

 // Optional Guest Contact Info (Populated if user is not logged in)
 reviewerName  String?
 reviewerEmail String?

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([userId])
 @@map("service_reviews")
}
