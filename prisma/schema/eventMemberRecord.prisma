model EventMemberRecord {
  id      Int   @id @default(autoincrement())
  eventId Int
  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  sessionId Int? // Optional link to a specific weekly session
  session   EventSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Submitter / Attendee User Relation
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Attendance & Feedback Fields
  status      AttendanceStatus @default(PRESENT)
  sessionDate DateTime?        @db.Date // Specific roll call date (YYYY-MM-DD)

  rating  Int? // 1-5 Rating score
  comment String? @db.Text // Discussion comment / book feedback

  // Dynamic Campaign & User Submissions
  submissionData Json?
  isApproved     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([eventId, userId, sessionDate])
  @@map("event_member_records")
}
