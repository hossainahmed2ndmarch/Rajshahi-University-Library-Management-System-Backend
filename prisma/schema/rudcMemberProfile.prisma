// RUDC Debate Club Member Profile

model RudcMemberProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  whatsappNumber        String?
  skills                String[]               @default([])
  permanentAddress      String?                @db.Text
  isAffiliatedWithOther Boolean                @default(false)
  otherOrgName          String?
  rudcTermsAccepted     Boolean                @default(true)
  isRudcMember          Boolean                @default(false)
  rudcMemberType        RudcMemberType?
  rudcStatus            RudcApplicationStatus?
  rudcJoinedAt          DateTime?

  // Supervisor Hierarchy (RUDC Specific)
  supervisorId String?
  supervisor   User?   @relation("SupervisorVolunteers", fields: [supervisorId], references: [id], onDelete: SetNull)

  // Interview & Recruitment Pipeline (RUDC Specific)
  interviewDate        DateTime?
  interviewNotes       String?   @db.Text
  interviewEmailSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRudcMember, rudcMemberType])
  @@index([rudcStatus])
  @@index([supervisorId])
  @@map("rudc_member_profiles")
}
