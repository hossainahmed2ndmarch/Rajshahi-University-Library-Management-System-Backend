// Model User (Root Identity & Better-Auth Compatible)

model User {
  id            String  @id @default(cuid())
  name          String
  email         String? @unique
  emailVerified Boolean @default(false)
  phone         String? @unique
  phoneVerified Boolean @default(false)
  password      String?
  avatarUrl     String?

  // Personal Demographics
  gender      Gender?
  dateOfBirth DateTime? @db.Date

  // RBAC & Lifecycle
  role   UserRole     @default(GENERAL_USER)
  status UserStatus   @default(ACTIVE)
  org    Organization @default(RUIL)

  // 1:1 Unified Academic Profile (Shared by RUIL & RUDC members)
  academicProfile AcademicProfile?

  // Organization Specific Profiles
  ruilProfile       RuilMemberProfile?
  rudcProfile       RudcMemberProfile?
  supervisedMembers RudcMemberProfile[] @relation("SupervisorVolunteers")

  // E-Commerce Delivery Address Book
  addresses UserAddress[]

  // Better-Auth Relations
  sessions Session[]
  accounts Account[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relation Arrays (1:N)
  booksAdded      Book[]         @relation("BooksAdded")
  authorProfile   Author?        @relation("UserAuthorProfile")
  booksDonated    Book[]         @relation("BooksDonated")
  fundDonations   FundDonation[] @relation("UserFundDonations")
  borrows         Borrow[]       @relation("UserBorrows")
  approvedBorrows Borrow[]       @relation("ApprovedBorrows")
  returnedBorrows Borrow[]       @relation("ReturnedBorrows")

  orders Order[] @relation("UserOrders")

  donations           Donation[]          @relation("UserDonations")
  receivedDonations   Donation[]          @relation("ReceivedDonations")
  shifts              ShiftLog[]          @relation("UserShifts")
  schedules           ShifterSchedule[]   @relation("UserSchedules")
  verifiedShifts      ShiftLog[]          @relation("VerifiedShifts")
  bookReviews         BookReview[]
  serviceReviews      ServiceReview[]
  payments            Payment[]
  memberRecords       EventMemberRecord[]
  rudcTeams           UserRudcTeam[]
  iyanotPayments      RudcIyanot[]        @relation("UserIyanot")
  iyanotCollectedByMe RudcIyanot[]        @relation("IyanotCollector")
  articlesSubmitted   Article[]           @relation("UserSubmittedArticles")

  @@index([role])
  @@index([status])
  @@index([org])
  @@map("users")
}
