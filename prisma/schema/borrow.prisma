// Model Borrow 

model Borrow {
 id Int @id @default(autoincrement())

 // Borrower Relation
 userId Int
 user   User @relation("UserBorrows", fields: [userId], references: [id], onDelete: Cascade)

 // Book Relation
 bookId Int
 book   Book @relation(fields: [bookId], references: [id])

 // Approval Relation 
 approvedById Int?
 approvedBy   User? @relation("ApprovedBorrows", fields: [approvedById], references: [id], onDelete: SetNull)

 // Return Processed By Relation (which staff member was present during return)
 returnedById Int?
 returnedBy   User? @relation("ReturnedBorrows", fields: [returnedById], references: [id], onDelete: SetNull)

 // Status & Timestamps Pipeline
 requestedAt DateTime  @default(now())
 approvedAt  DateTime?
 dueDate     DateTime?
 returnedAt  DateTime?

 status     BorrowStatus @default(PENDING)
 fineAmount Float        @default(0.0)

 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt

 @@index([userId])
 @@index([bookId])
 @@index([status])
 @@map("borrows")
}
