model RudcIyanot {
  id     Int  @id @default(autoincrement())
  userId Int
  user   User @relation("UserIyanot", fields: [userId], references: [id], onDelete: Cascade)

  month         Int // 1 - 12
  year          Int // e.g. 2026
  amount        Float               @default(50.00) // 50 BDT
  status        IyanotStatus        @default(PENDING)
  paymentMethod IyanotPaymentMethod @default(ONLINE)

  // Tracking who collected offline cash (Admin / Super Admin / Supervisor)
  collectedById Int?
  collectedBy   User? @relation("IyanotCollector", fields: [collectedById], references: [id])

  transactionId String?
  receiptNo     String?   @unique
  remarks       String?
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, month, year])
  @@index([status])
  @@index([collectedById])
  @@map("rudc_iyanot")
}
