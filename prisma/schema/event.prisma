model Event {
  id         Int          @id @default(autoincrement())
  org        Organization @default(RUIL)
  activityId Int?
  activity   Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)

  title    String
  slug     String      @unique
  category String?
  status   EventStatus @default(UPCOMING)

  scheduleText String?
  location     String?
  bannerImage  String?
  startDate    DateTime?
  endDate      DateTime?

  // --- Fundraising Specific New Fields ---
  isFundraiser Boolean @default(false)
  targetAmount Float? // Fund Target Goal (e.g. 500000.00)
  raisedAmount Float   @default(0.0) // Total Collected Amount

  books          Book[]
  currentChapter String?

  metadata Json?
  isActive Boolean @default(true)

  sessions      EventSession[]
  memberRecords EventMemberRecord[]
  fundDonations FundDonation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}
