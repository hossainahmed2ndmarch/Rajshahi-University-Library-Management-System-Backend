model Book {
  id           Int      @id @default(autoincrement())
  title        String
  isbn         String   @unique
  locationCell String
  category     String
  categories   String[] @default([])
  pages        Int?
  type         BookType

  // Publisher Relation
  publisherId Int?
  publisher   Publisher? @relation(fields: [publisherId], references: [id], onDelete: SetNull)

  // Authors Junction Relation
  authors BookAuthor[]

  // Pricing & Custom Override Discount
  buyPrice       Decimal? @db.Decimal(12, 2)
  sellPrice      Decimal? @db.Decimal(12, 2)
  customDiscount Decimal? @db.Decimal(5, 2) // Null = Use Publisher's defaultDiscount
  borrowStock    Int      @default(0)
  sellStock      Int      @default(0)

  coverImage  String?
  images      String[] @default([])
  description String?  @db.Text
  isArchived  Boolean  @default(false)

  // Registration Relations
  addedById   Int?
  addedBy     User? @relation("BooksAdded", fields: [addedById], references: [id], onDelete: SetNull)
  donatedById Int?
  donatedBy   User? @relation("BooksDonated", fields: [donatedById], references: [id], onDelete: SetNull)

  // Virtual Relations
  borrows   Borrow[]
  purchases Purchase[]
  donations Donation[]   @relation("CatalogedFromDonation")
  reviews   BookReview[]
  articles  Article[]
  events    Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type, isArchived])
  @@index([category])
  @@index([publisherId])
  @@map("books")
}
